# Server-side only (read by api/claude.ts). Never prefixed with VITE_ —
# see plan/engineering/SETUP.md "The one rule that actually matters".
ANTHROPIC_API_KEY=sk-ant-REPLACE-ME

# Client-side, deliberately. This is what makes the host swappable — see
# plan/engineering/ARCHITECTURE-RULES.md "Hosting is swappable too".
VITE_API_BASE_URL=/api
